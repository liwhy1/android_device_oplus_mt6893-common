binder_call(surfaceflinger, mtk_hal_mmagent)
hal_client_domain(surfaceflinger, hal_mtk_mmagent)

# Allow surfaceflinger to read vendor_dp_prop
allow surfaceflinger vendor_dp_prop:file r_file_perms;
get_prop(surfaceflinger, vendor_dp_prop);

# Allow surfaceflinger to access Mali GPU device
allow surfaceflinger mali_device:chr_file rw_file_perms;
