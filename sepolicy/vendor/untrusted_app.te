# Allow untrusted_app to access codec2 HAL service
hal_client_domain(untrusted_app, hal_codec2);

# Allow untrusted_app to access MediaTek C2 video decoder properties
get_prop(untrusted_app, vendor_mtk_c2_log_prop);

# Allow untrusted_app to access video devices
allow untrusted_app video_device_type:chr_file rw_file_perms;

# Allow untrusted_app to access MediaTek video devices
allow untrusted_app mtk_mdp_device:chr_file rw_file_perms;
