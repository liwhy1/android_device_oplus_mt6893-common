r_dir_file(mtk_hal_pq, vendor_proc_oplus_version)
set_prop(mtk_hal_pq, vendor_mtk_default_prop)
set_prop(mtk_hal_pq, vendor_mtk_pq_prop)
get_prop(mtk_hal_pq, vendor_mtk_pq_ro_prop)

# Allow mtk_hal_pq to access MediaTek C2 video decoder properties
get_prop(mtk_hal_pq, vendor_mtk_c2_log_prop)
set_prop(mtk_hal_pq, vendor_mtk_c2_log_prop)
allow mtk_hal_pq vendor_proc_display:file rw_file_perms;
allow mtk_hal_pq ion_device:chr_file rw_file_perms;
