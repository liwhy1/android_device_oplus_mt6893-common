}

prebuilt_etc {
    name: "init.recovery.mt6893.rc",
    src: "etc/init.recovery.mt6893.rc",
    sub_dir: "root",
    recovery: true,
}

prebuilt_etc {
    name: "init.target.rc",
    src: "etc/init.target.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "init.oplus.rc",
    src: "etc/init.oplus.rc",
	sub_dir: "init",
    device_specific: true,
}