allow system_server vendor_proc_charger:dir search;
allow system_server vendor_proc_display:dir search;
allow system_server vendor_proc_oplus_version:dir search ;
allow system_server vendor_proc_oplus_sensor_feature:dir search;
allow system_server vendor_sysfs_usb_supply:file rw_file_perms;
allow system_server vendor_sysfs_usb_supply:file { read open getattr setattr };
allow system_server proc_boost_pool:file rw_file_perms;
allow system_server proc_boost_pool:dir r_dir_perms;

# Allow system_server to access MediaTek C2 video decoder properties
get_prop(system_server, vendor_mtk_c2_log_prop);
set_prop(system_server, vendor_mtk_c2_log_prop);

# Allow system_server to access all vendor properties
get_prop(system_server, vendor_default_prop);

# Allow system_server to access codec2 HAL service
hal_client_domain(system_server, hal_codec2);

# Allow system_server to access video devices
allow system_server video_device_type:chr_file rw_file_perms;

# Allow system_server to access MediaTek video devices
allow system_server mtk_mdp_device:chr_file rw_file_perms;

# Allow system_server to access memory and file descriptors
allow system_server ion_device:chr_file rw_file_perms;
allow system_server proc_meminfo:file r_file_perms;
allow system_server proc_pid_max:file r_file_perms;
allow system_server proc_stat:file r_file_perms;


# Allow system_server to access shared memory
allow system_server ashmem_device:chr_file rw_file_perms;
allow system_server hal_graphics_mapper_hwservice:hwservice_manager find;
